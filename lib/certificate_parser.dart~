import 'dart:convert';
import 'package:asn1lib/asn1lib.dart';
class CertificateParser {
  static Map<String, String> getPublicKeyAndSignature(
      String certificateBase64) {
    // Decode the base64 encoded certificate
    final certificateBytes = base64.decode(certificateBase64);

    // Parse the ASN.1 structure
    final asn1Parser = ASN1Parser(certificateBytes);
    final topLevelSequence = asn1Parser.nextObject() as ASN1Sequence;

    // Navigate to the Subject Public Key Info
    final tbsCertificate = topLevelSequence.elements[0] as ASN1Sequence;
    final subjectPublicKeyInfo = tbsCertificate.elements[6] as ASN1Sequence;

    // Get the public key
    final publicKey = subjectPublicKeyInfo.elements[1] as ASN1BitString;
    final publicKeyBytes = publicKey.valueBytes;

    // Get the signature (assuming it's located in the last element of the top-level sequence)
    final signature = topLevelSequence.elements[2] as ASN1BitString;
    final signatureBytes = signature.valueBytes;

    // Convert to hex string or base64 as needed
    final publicKeyHex = hex.encode(publicKeyBytes);
    final signatureHex = hex.encode(signatureBytes);

    return {
      'publicKey': publicKeyHex,
      'signature': signatureHex,
    };
  }
}
